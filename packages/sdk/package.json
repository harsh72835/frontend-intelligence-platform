{
  "name": "@fip/sdk",
  "version": "0.1.0",
  "description": "Browser SDK for Frontend Intelligence Platform — Web Vitals, errors, API timings, and more, shipped to a self-hosted FIP dashboard.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "web-vitals": "^3.5.2"
  },
  "devDependencies": {
    "@fip/shared": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0"
  }
}
