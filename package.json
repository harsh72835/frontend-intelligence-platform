{
  "name": "frontend-intelligence-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:dashboard": "pnpm --filter @fip/dashboard dev",
    "dev:sample": "pnpm --filter @fip/sample-app dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "app:create": "tsx scripts/create-app.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "recharts": "^2.15.4",
    "source-map-js": "^1.2.1"
  }
}
